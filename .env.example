# 复制为 .env 后填写：cp .env.example .env
# .env 已被 git 忽略，绝不能提交。配置说明见 docs/API_KEY_SETUP.md。
#
# ANTHROPIC_API_KEY 只由服务端读取，绝不能放进手机端或 EXPO_PUBLIC_ 变量。
# API 服务需要 key；App 选择内置规则时不需要 API。

ANTHROPIC_API_KEY=

# 可选：模型（默认 claude-haiku-5-5）、思考力度（low / medium / high）、本机端口与限额
# MORPH_AI_MODEL=claude-haiku-5-5
# MORPH_AI_EFFORT=low
# MORPH_API_PORT=8787
# 每台设备每分钟几次、每天花多少美元，所有设备合计每天花多少美元；一台设备一天几次回复不像修改计划就停用（D-193）
# MORPH_PER_MINUTE_LIMIT=10
# MORPH_DEVICE_DAILY_USD=0.2
# MORPH_GLOBAL_DAILY_USD=2
# MORPH_OFF_PLAN_LIMIT=5
# 每次回复最多多少 token（含思考）
# MORPH_MAX_OUTPUT_TOKENS=16000
# 设置后请求必须带同样的令牌（打包 App 时用 EXPO_PUBLIC_MORPH_CLIENT_TOKEN 传入）。见 docs/DEPLOY.md
# MORPH_CLIENT_TOKEN=
# 测试期保存请求（D-240）：设置后每次转发成功把提示词、用户的话和回复追加到这个文件；不设就不保存
# MORPH_REQUESTS_FILE=data/requests.jsonl

# M3 云端数据（尚未使用）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# 官方手机发布构建；按 AGENTS.md 的命令 export 四个变量，并先运行 npm run check:mobile-env。
# 预检只读已导出的环境变量，不会自动加载 .env。
# 这些值会进入安装包，不要在这里放云端 AI key。源码自用版可以不配中继。
EXPO_PUBLIC_MORPH_API_URL=https://morph-api.stonetech.dev
EXPO_PUBLIC_MORPH_TOOLS_URL=https://morph-tools.stonetech.dev
EXPO_PUBLIC_MORPH_PACKS_URL=https://morph-tools.stonetech.dev/packs
EXPO_PUBLIC_MORPH_CLIENT_TOKEN=

# 仅用于手动 lab / lab-judge 实验的累计预算记录文件；不供 API 或 App 读取。
# LAB_LEDGER=/absolute/path/to/lab-ledger.json
