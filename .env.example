# Copy to `.env` and fill in: `cp .env.example .env`. `.env` is ignored by git and must never be
# committed. See `docs/API_KEY_SETUP.md` for configuration instructions.
#
# `ANTHROPIC_API_KEY` is read exclusively by the server and must never be placed in the mobile
# client or `EXPO_PUBLIC_` variables. The API service requires a key; the app does not require an
# API key when choosing built-in rules.

ANTHROPIC_API_KEY=

# Optional: model (default `claude-haiku-5-5`), effort level (`low` / `medium` / `high`), local port, and limits.
# MORPH_AI_MODEL=claude-haiku-5-5
# MORPH_AI_EFFORT=low
# MORPH_API_PORT=8787
# Requests per minute per device, daily dollar spending limit, and total daily dollar spending limit across all devices; discontinue if request frequency resembles non-plan-modification behavior on a single device per day (D-193).
# MORPH_PER_MINUTE_LIMIT=10
# MORPH_DEVICE_DAILY_USD=0.2
# MORPH_GLOBAL_DAILY_USD=2
# MORPH_OFF_PLAN_LIMIT=5
# Maximum tokens per response (including thinking tokens).
# MORPH_MAX_OUTPUT_TOKENS=16000
# When set, requests must carry the matching token (passed via `EXPO_PUBLIC_MORPH_CLIENT_TOKEN` when packaging the app). See `docs/DEPLOY.md`.
# MORPH_CLIENT_TOKEN=
# Request persistence during the testing phase (D-240): when set, appends prompts, user inputs, and responses to this file upon each successful forwarding; disabled if unset.
# MORPH_REQUESTS_FILE=data/requests.jsonl

# M3 cloud data (not yet in use).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Official mobile release builds; export the four variables following the commands in `AGENTS.md`
# and run `npm run check:mobile-env` first. Pre-checks read only exported environment variables and
# do not automatically load `.env`. These values will be bundled into the installation package; do
# not store cloud AI keys here. Self-hosted source installations may omit this configuration.
EXPO_PUBLIC_MORPH_API_URL=https://morph-api.stonetech.dev
EXPO_PUBLIC_MORPH_TOOLS_URL=https://morph-tools.stonetech.dev
EXPO_PUBLIC_MORPH_PACKS_URL=https://morph-tools.stonetech.dev/packs
EXPO_PUBLIC_MORPH_CLIENT_TOKEN=

# Cumulative budget tracking file used exclusively for manual lab / lab-judge experiments; not read by the API or the app.
# LAB_LEDGER=/absolute/path/to/lab-ledger.json
