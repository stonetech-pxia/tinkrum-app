<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Exposes temporary files of the current run (runs/ cache directory) via content:// URIs to sharing targets with read-only permission. -->
    <provider
        android:name=".MorphShareFileProvider"
        android:authorities="${applicationId}.MorphShareFileProvider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/morph_share_paths" />
    </provider>
  </application>
</manifest>
