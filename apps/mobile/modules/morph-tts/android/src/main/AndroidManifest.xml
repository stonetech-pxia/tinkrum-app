<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Must be declared starting from Android 11 to connect to the system TTS engine (package visibility), otherwise TextToSpeech initialization fails (D-270). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>
</manifest>
