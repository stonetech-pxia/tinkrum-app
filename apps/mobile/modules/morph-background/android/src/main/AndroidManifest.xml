<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Keep long tasks running even when switching to other apps (D-160): foreground service.
    Starting from Android 15, uses mediaProcessing (for video and audio processing; falls back
    to dataSync when the system does not support this type); earlier versions use dataSync.
    Google Play requires declaring the purpose of these types in the background.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- Progress and completion notifications; prompts once on the first run of a long task starting from Android 13 (D-161). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keeps CPU awake after screen lock so the task continues. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- When the user swipes Morph away from recent tasks, they want it closed: service stops accordingly. -->
    <service
      android:name="expo.modules.morphbackground.MorphBackgroundService"
      android:exported="false"
      android:stopWithTask="true"
      android:foregroundServiceType="mediaProcessing|dataSync" />
  </application>
</manifest>
