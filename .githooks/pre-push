#!/bin/sh
set -eu

# 只为真正要发出的 HEAD 检查；别把另一个分支或未提交的改动当成待推送版本。
cd "$(git rev-parse --show-toplevel)"
head_commit=$(git rev-parse HEAD)
has_update=false
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  has_update=true
  if [ "$(git rev-parse --verify "$local_oid^{commit}")" != "$head_commit" ]; then
    echo 'pre-push: push from the clean checkout of the commit being sent.' >&2
    exit 1
  fi
done
[ "$has_update" = true ] || exit 0
if [ -n "$(git status --porcelain)" ]; then
  echo 'pre-push: commit or set aside local changes before checking the pushed commit.' >&2
  exit 1
fi
echo 'pre-push: running npm run check'
npm run check </dev/null
if [ "$(git rev-parse HEAD)" != "$head_commit" ] || [ -n "$(git status --porcelain)" ]; then
  echo 'pre-push: checkout changed while checks were running; check the final commit again.' >&2
  exit 1
fi
