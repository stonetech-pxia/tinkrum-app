{
  "name": "morph",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "npm run start --workspace @morph/mobile --",
    "ios": "npm run ios --workspace @morph/mobile --",
    "android": "npm run android --workspace @morph/mobile --",
    "api": "npm run start --workspace @morph/api",
    "ios:ai": "npm run ios:ai --workspace @morph/mobile --",
    "eval": "npm run eval --workspace @morph/api --",
    "tools": "npm run tools --workspace @morph/api --",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:release && npm run test:native-dsp && npm run test:native-archive && npm run check:licenses && npm run check:locales",
    "test:native-dsp": "node scripts/test-native-dsp.mjs",
    "test:native-archive": "node scripts/test-native-archive.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "test:word-regression": "tsx tests/word-regression/run.ts",
    "hooks:install": "sh scripts/install-hooks.sh",
    "check:mobile-env": "node scripts/check-mobile-env.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
